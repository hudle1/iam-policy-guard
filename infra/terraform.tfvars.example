# Copy to terraform.tfvars (gitignored) and fill in.
github_owner = "your-github-username"
github_repo  = "iam-policy-guard"
# Public, immutable IDs for GitHub's OIDC subject. From sub_claim_prefix in:
#   gh api repos/OWNER/REPO/actions/oidc/customization/sub
github_owner_id = 12345678
github_repo_id  = 987654321
aws_account_id  = "111122223333" # your sandbox account; Terraform refuses any other
region          = "us-east-1"
aws_profile     = "sandbox-admin" # SSO profile: aws configure sso
budget_email    = "you@example.com"
# create_oidc_provider = false   # if the account already has the GitHub OIDC provider
